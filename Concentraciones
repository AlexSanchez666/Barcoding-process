#PARA CÁLCULO DE CONCENTRACION
import ipywidgets as widgets
from IPython.display import display, clear_output

#Conversión a litros
unidad_a_litros = {
    "L": 1,
    "mL": 1e-3,
    "µL": 1e-6,
    "m³": 1000
}

# Crear cajas y menús de entrada
C1 = widgets.FloatText(description="C1 (Inicial)", value=0.0)
V1 = widgets.FloatText(description="V1 (Volúmen)", value=0.0)
V1_unit = widgets.Dropdown(options=list(unidad_a_litros.keys()), value="mL", description="Unidad V1")

C2 = widgets.FloatText(description="C2 (Final)", value=0.0)
V2 = widgets.FloatText(description="V2 (Volúmen)", value=0.0)
V2_unit = widgets.Dropdown(options=list(unidad_a_litros.keys()), value="mL", description="Unidad V2")

# Menú para seleccionar la incógnita
incognita = widgets.Dropdown(
    options=["V1", "C1", "V2", "C2"],
    value="V1",
    description="Calcular:"
)

# Botón de cálculo
boton = widgets.Button(description="Calcular", button_style="success")

# Salida
salida = widgets.Output()

def calcular(b):
    with salida:
        clear_output()
        try:
            # Conversión de volúmenes a litros
            V1_L = V1.value * unidad_a_litros[V1_unit.value]
            V2_L = V2.value * unidad_a_litros[V2_unit.value]
            
            if incognita.value == "V1":
                resultado_L = (C2.value * V2_L) / C1.value
                resultado = resultado_L / unidad_a_litros[V1_unit.value]  # volver a la unidad original
                print(f"V1 = {resultado:.3f} {V1_unit.value}")
            
            elif incognita.value == "C1":
                resultado = (C2.value * V2_L) / V1_L
                print(f"C1 = {resultado:.3f} (misma unidad que C2)")
            
            elif incognita.value == "V2":
                resultado_L = (C1.value * V1_L) / C2.value
                resultado = resultado_L / unidad_a_litros[V2_unit.value]
                print(f"V2 = {resultado:.3f} {V2_unit.value}")
            
            elif incognita.value == "C2":
                resultado = (C1.value * V1_L) / V2_L
                print(f"C2 = {resultado:.3f} (misma unidad que C1)")
            
        except ZeroDivisionError:
            print("⚠️ Error: no se puede dividir para cero. Revisa los valores.")
        except Exception as e:
            print(f"⚠️ Ocurrió un error: {e}")

boton.on_click(calcular)

# Mostrar widgets
display(C1, V1, V1_unit, C2, V2, V2_unit, incognita, boton, salida)
