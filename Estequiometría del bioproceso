import numpy as np

# Sustrato
S_FORMULA = {'C': 6, 'H': 12, 'O': 6}
M_S = 180  # g/mol Peso del compuesto

# Fuente de N: amonio (urea)
FN_FORMULA = {'N': 1, 'H': 3}

# Biomasa ejemplo
X_FORMULA = {'C': 1, 'H': 1.8, 'N': 0.5, 'O': 0.2}
M_X = 23  # g/mol Peso del compuesto

# Rendimiento biomasa/sustrato (aerobio)
Y_XS = 0.45

# RQ respiratorio impuesto
RQ = 0.7

# CO2 adicional por ureasa (opcional)
f_urea_hidrolizada = 1.0
CO2_UREASA = f_urea_hidrolizada * 1.0   # mol CO2 / mol glucosa eq

# Biomasa formada
c = (Y_XS * M_S) / M_X
print(f"c (Biomasa): {c:.4f} moles")

# N requerido
a = c * X_FORMULA['N']
print(f"a (NH3 requerido): {a:.4f} moles")

# Balance de Carbono

C_in = S_FORMULA['C']
C_biomasa = c * X_FORMULA['C']

CO2_resp = C_in - C_biomasa
CO2_total = CO2_resp + CO2_UREASA

print(f"CO2 respiratorio: {CO2_resp:.4f} moles")
print(f"CO2 total (incluye ureasa): {CO2_total:.4f} moles")

# O2 calculado desde RQ

e = CO2_resp / RQ
print(f"O2 consumido: {e:.4f} moles")

# Balance de Hidrógeno → Agua

H_in = S_FORMULA['H'] + a * FN_FORMULA['H']
H_biomasa = c * X_FORMULA['H']

g = (H_in - H_biomasa) / 2
print(f"H2O formada: {g:.4f} moles")

# Verificación de Oxígeno 

O_in = S_FORMULA['O'] + 2 * e
O_out = (c * X_FORMULA['O'] +
         CO2_resp * 2 +
         g)

error_O = abs(O_in - O_out)

print(f"Chequeo balance O: error = {error_O:.4e}")

# RESULTADOS

print("\n" + "="*55)
print("ECUACIÓN ESTEQUIOMÉTRICA ( RQ = 0.7)")
print("="*55)

print(f"1 C6H12O6 + {a:.4f} NH3 + {e:.4f} O2 -> "
      f"{c:.4f} CH1.8N0.5O0.2 + "
      f"{CO2_total:.4f} CO2 + {g:.4f} H2O")

print("\nNotas:")
print("- Metabolismo respiratorio dominante.")
print("- No hay fermentación láctica.")
print("- RQ < 1 indica alta eficiencia oxidativa.")
print("- CO2_total incluye respiración + ureasa.")
print("="*55)
